<div class="bg-light_brown p-8 rounded-lg shadow-lg w-full max-w-md flex flex-col items-center justify-between h-full">
  <h2 class="text-4xl text-dark_brown underlined">Log in</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="field">
      <%= f.label :email, class: "text-dark_brown text-2xl mt-2" %><br />
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= f.label :password, class: "text-dark_brown text-2xl mt-2" %><br />
      <%= f.password_field :password, autocomplete: "current-password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="field">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me %>
      </div>
    <% end %>

    <div class="actions flex justify-center mt-4">
      <%= f.submit "Log in", class: "text-2x1 bg-medium_brown text-dark_brown p-4 rounded-lg w-30 hover:underline"  %>
    </div>
  <% end %>
  <div class="flex justify-center items-center h-full">
    <div class="text-center">
      <%= render "devise/shared/links", class: "text-2x1  text-dark_brown hover:underline px-4" %>
    </div>
  </div>
</div>
