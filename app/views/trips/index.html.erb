<div>
  <h1 class="text-3xl font-semibold text-gray-800 mb-6">All Trips</h1>
</div>
<table class="table-auto w-full border-collapse border border-medium_brown">
  <thead>
    <tr class="bg-pale_brown">
      <th class="border border-medium_brown px-4 py-2 text-left text-dark_logo">Name</th>
      <th class="border border-medium_brown px-4 py-2 text-left text-dark_logo">Description</th>
      <th class="border border-medium_brown px-4 py-2 text-left text-dark_logo">Start Date</th>
      <th class="border border-medium_brown px-4 py-2 text-left text-dark_logo">End Date</th>
      <th class="border border-medium_brown px-4 py-2 text-left text-dark_logo">Owner</th>
    </tr>
  </thead>
  <tbody>
    <% if @trips.any? %>
      <% @trips.each do |trip| %>
        <tr class="hover:bg-light_brown">
          <td class="border border-medium_brown px-4 py-2 text-dark_brown"><%= link_to trip.name, trip %></td>
          <td class="border border-medium_brown px-4 py-2 text-dark_brown"><%= trip.description %></td>
          <td class="border border-medium_brown px-4 py-2 text-dark_brown"><%= trip.start_date %></td>
          <td class="border border-medium_brown px-4 py-2 text-dark_brown"><%= trip.end_date %></td>
          <td class="border border-medium_brown px-4 py-2 text-dark_brown"><%= trip.user.email %></td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td class="border border-medium_brown px-4 py-2 text-center text-light_brown" colspan="5">No trips found.</td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Create New Trip', new_trip_path, class: "text-3x1 text-white bg-blue-500 p-2 rounded hover:bg-blue-600" %>