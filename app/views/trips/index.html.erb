<h1 class="text-3xl font-semibold text-gray-800 mb-6">All Trips</h1>

<% if @trips.any? %>
  <ul class="space-y-4">
    <% @trips.each do |trip| %>
      <li class="border-b border-gray-200 pb-4 mb-4">
        <h2 class="text-2xl font-semibold text-gray-800"><%= link_to trip.name, trip %></h2>
        <p class="text-md text-gray-600"><%= trip.description %></p>
        <p class="text-sm text-gray-500">Start Date: <%= trip.start_date %></p>
        <p class="text-sm text-gray-500">End Date: <%= trip.end_date %></p>
        <p class="text-sm text-gray-500">Owner: <%= trip.user.email %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-md text-gray-600">No trips found.</p>
<% end %>