<div class="max-w-3xl mx-auto mt-10 p-6 bg-white shadow-md rounded-lg">
  <!-- Trip Name -->
  <h1 class="text-3xl font-bold text-gray-800 mb-4"><%= @trip.name %></h1>

  <!-- Trip Description -->
  <p class="text-lg text-gray-700 mb-4"><%= @trip.description %></p>

  <!-- Trip Dates -->
  <p class="text-md text-gray-600 mb-6">
    <strong class="font-medium text-gray-800">Dates:</strong>
    <%= @trip.start_date %> - <%= @trip.end_date %>
  </p>

  <!-- Participants -->
  <h2 class="text-2xl font-semibold text-gray-800 mb-4">Participants:</h2>
  <ul class="space-y-2">
    <% @trip.users.each do |user| %>
      <li class="text-md text-gray-700">
        <%= user.email %>
      </li>
    <% end %>
  </ul>

  <!-- Expenses Section -->
  <h2 class="mt-6 text-lg font-bold">Expenses</h2>
  <h2 class="font-bold">Total Expenses</h2>
  <p><%= number_to_currency(@total_expenses) %></p>

  <!-- Add Expense Button -->
  <div class="mt-6">
    <%= link_to 'Add Expense', new_trip_expense_path(@trip), class: 'bg-red-300 text-white px-4 py-2 rounded hover:bg-red-400 focus:ring focus:ring-red-500 focus:outline-none' %>
  </div>

  <div class="mt-4">
    <% if @trip.expenses.any? %>
      <ul class="space-y-2">
        <% @trip.expenses.each do |expense| %>
          <li class="flex items-center justify-between p-4 bg-gray-100 rounded-lg">
            <div>
              <p class="font-bold"><%= expense.description %></p>
              <p class="text-sm text-gray-600">Amount: <%= number_to_currency(expense.amount) %></p>
              <p class="text-sm text-gray-600">Date: <%= expense.date %></p>
              <p class="text-sm text-gray-600">Shared by: <%= expense.users.map(&:email).join(", ") %></p>
            </div>
            <div class="flex space-x-2">
              <% if @trip.owner == current_user || expense.creator == current_user %>
                <%= link_to 'Edit', edit_trip_expense_path(@trip, expense), class: 'text-blue-500 hover:underline' %>
                <%= link_to 'Delete', trip_expense_path(@trip, expense), method: :delete, data: { confirm: 'Are you sure?' }, class: 'text-red-500 hover:underline' %>
              <% end %>
              <% if expense.users.include?(current_user) && expense.creator != current_user %>
                <%= link_to 'Leave', leave_trip_expense_path(@trip, expense), method: :post, data: { confirm: 'Are you sure you want to leave this expense?' }, class: 'text-yellow-500 hover:underline' %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>No expenses added yet.</p>
    <% end %>
  </div>

  <!-- Edit & Delete Button -->
  <% if @trip.owner == current_user %>
    <div class="mt-6">
      <%= link_to 'Edit Trip', edit_trip_path(@trip), class: 'text-blue-500 hover:underline' %>
    </div>
    <div class="mt-6">
      <%= link_to 'Delete Trip', @trip, method: :delete, data: { confirm: 'Are you sure you want to delete this trip?' }, class: 'text-red-500 hover:underline' %>
    </div>
  <% elsif @trip.users.include?(current_user) %>
    <!-- Leave Trip Button -->
    <div class="mt-6">
      <%= link_to 'Leave Trip', leave_trip_path(@trip), method: :post, data: { confirm: 'Are you sure you want to leave this trip?' }, class: 'text-red-500 hover:underline' %>
    </div>
  <% end %>

    <!-- Back Link -->
  <div class="mt-4">
    <%= link_to "Back to Trips", trips_path, class: "text-dark_log hover:underline hover:text-light_brown" %>
  </div>
</div>