<div class="max-w-3xl mx-auto mt-10 p-6 bg-white shadow-md rounded-lg">
  <!-- Trip Name -->
  <h1 class="flex justify-center w-fill pb-2 pt-2 rounded-md bg-light_brown text-3xl font-bold text-dark_brown mb-4"><%= @trip.name %></h1>

  <!-- Trip Description -->
  <p class="text-lg text-dark_brown mb-4">
    <strong class="text-dark_brown">Description: </strong>
    <%= @trip.description %></p>

  <!-- Trip Dates -->
  <p class="text-md text-dark_brown mb-6">
    <strong class="font-medium text-dark_brown">Dates:</strong>
    <%= @trip.start_date %> - <%= @trip.end_date %>
  </p>

  <!-- Participants -->
  <h2 class="text-2xl font-semibold text-dark_brown mb-4">Participants:</h2>
  <ul class="space-y-2">
    <% @trip.users.each do |user| %>
      <li class="text-md text-dark_brown">
        <%= user.email %>
      </li>
    <% end %>
  </ul>

  <!-- Expenses Section -->
  <h2 class="mt-6 text-lg font-bold text-dark_brown">Expenses</h2>
  <h2 class="font-bold text-dark_brown">Total Expenses</h2>
  <p><%= number_to_currency(@total_expenses) %></p>

  <!-- Add Expense Button -->
  <div class="mt-6">
    <%= link_to 'Add Expense', new_trip_expense_path(@trip), class: 'bg-accent_red text-white px-4 py-2 rounded hover:bg-red-400 focus:ring focus:ring-red-500 focus:outline-none button-animation' %>
  </div>

  <div class="mt-4">
    <% if @trip.expenses.any? %>
      <ul class="space-y-2">
        <% @trip.expenses.each do |expense| %>
          <li class="flex items-center justify-between p-4 bg-light_brown rounded-lg">
            <div>
              <p class="font-bold"><%= expense.description %></p>
              <p class="text-sm"><em><%= expense.category %></em></p>
              <p class="text-sm text-dark_brown">Amount: <%= number_to_currency(expense.amount) %></p>
              <p class="text-sm text-dark_brown">Date: <%= expense.date %></p>
              <p class="text-sm text-dark_brown">
                Shared by: 
                <%= expense.expense_participants.map do |participant| 
                  "#{participant.user.email} (#{number_to_currency(participant.share_value)})"
                end.join(", ") %>
              </p>
            </div>
            <div class="flex space-x-2">
              <% if @trip.owner == current_user || expense.creator == current_user %>
                <!-- <%= link_to 'Edit', edit_trip_expense_path(@trip, expense), class: 'text-accent_green hover:underline' %> -->
                <%= link_to 'Delete', trip_expense_path(@trip, expense), method: :delete, data: { confirm: 'Are you sure?' }, class: 'text-accent_red hover:underline' %>
              <% end %>
              <% if expense.users.include?(current_user) && expense.creator != current_user %>
                <%= link_to 'Leave', leave_trip_expense_path(@trip, expense), method: :post, data: { confirm: 'Are you sure you want to leave this expense?' }, class: 'text-yellow-500 hover:underline' %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-dark_brown">No expenses added yet.</p>
    <% end %>
  </div>

  <!-- Edit & Delete Button -->
  <div class="flex flex-row items-center justify-between mt-6">
    <!-- Conditional Buttons -->
    <div class="flex flex-row space-x-4">
      <% if @trip.owner == current_user %>
        <%= link_to 'Edit Trip', edit_trip_path(@trip), class: 'text-accent_green hover:underline' %>
        <%= link_to 'Delete Trip', @trip, method: :delete, data: { confirm: 'Are you sure you want to delete this trip?' }, class: 'text-accent_red hover:underline' %>
      <% elsif @trip.users.include?(current_user) %>
        <%= link_to 'Leave Trip', leave_trip_path(@trip), method: :post, data: { confirm: 'Are you sure you want to leave this trip?' }, class: 'text-accent_red hover:underline' %>
      <% end %>
    </div>

    <!-- Back Link -->
    <div>
      <%= link_to "Back to Trips", trips_path, class: "text-dark_brown hover:underline hover:text-light_brown" %>
    </div>
  </div>
</div>