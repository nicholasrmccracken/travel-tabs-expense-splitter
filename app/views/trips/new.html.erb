<div class="max-w-3xl mx-auto mt-10 bg-light_brown shadow-md rounded-lg p-6">
  <% if @trip.errors.any? %>
    <div id="error_explanation">
      <ul>
        <% @trip.errors.full_messages.each do |message| %>
          <li class="text-center mx-auto text-red-500"><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class = "flex justify-center items-start">
    <h1 class="text-2xl font-bold text-primary rounded-lg px-4 py-2">Create a New Trip</h1>
  </div>
  <%= form_with model: @trip, local: true, class: "space-y-4" do |form| %>
    <!-- Trip Name -->
    <div class="flex flex-col">
      <%= form.label :name, "Trip Name", class: "mb-1 font-medium text-primary" %>
      <%= form.text_field :name, class: "border border-gray-300 rounded px-3 py-2 focus:ring focus:ring-secondary-red focus:outline-none" %>
    </div>

    <!-- Description -->
    <div class="flex flex-col">
      <%= form.label :description, "Description", class: "mb-1 font-medium text-primary" %>
      <%= form.text_area :description, rows: 4, class: "border border-gray-300 rounded px-3 py-2 focus:ring focus:ring-secondary-red focus:outline-none" %>
    </div>

    <!-- Start Date -->
    <div class="flex flex-col">
      <%= form.label :start_date, "Start Date", class: "mb-1 font-medium text-primary" %>
      <%= form.date_field :start_date, class: " border border-gray-300 rounded px-3 py-2 focus:ring focus:ring-secondary-red focus:outline-none" %>
    </div>

    <!-- End Date -->
    <div class="flex flex-col">
      <%= form.label :end_date, "End Date", class: "mb-1 font-medium text-primary" %>
      <%= form.date_field :end_date, class: "border border-gray-300 rounded px-3 py-2 focus:ring focus:ring-secondary-red focus:outline-none" %>
    </div>

    <!-- Participants -->
    <div class="flex flex-col">
      <%= form.label :participant_emails, "Participants", class: "mb-1 font-medium text-primary" %>
      <div class="flex space-x-2">
        <%= text_field_tag :participant_email, nil, placeholder: "Enter email", class: "flex-grow border border-gray-300 rounded px-3 py-2 focus:ring focus:ring-secondary-red focus:outline-none" %>
        <%= button_tag "Add", type: "button", id: "add-email-button", class: "w-1/4 bg-primary text-off_white px-4 py-2 rounded hover:bg-off_white hover:text-primary focus:ring focus:ring-secondary-red focus:outline-none button-animation" %>
      </div>
      <div id="email-list" class="space-y-2 mt-2">
      </div>
    </div>

    <!-- Submit Button -->
    <div>
      <%= form.submit "Create Trip", class: "w-full bg-primary text-off_white px-4 py-2 rounded hover:bg-off_white hover:text-primary focus:ring focus:ring-secondary-red focus:outline-none button-animation" %>
    </div>
  <% end %>

  <!-- Back Link -->
  <div class="mt-4">
    <%= link_to "Back to Trips", trips_path, class: "text-primary hover:underline hover:text-off_white button-animation" %>
  </div>
</div>

<%= javascript_include_tag 'email_list' %>