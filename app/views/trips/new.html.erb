<div class="max-w-3xl mx-auto mt-10 bg-off_white shadow-md rounded-lg p-6">
  <div class = "flex justify-center items-start">
    <h1 class="text-2xl font-bold text-primary rounded-lg px-4 py-2">Create a New Trip</h1>
  </div>
  <%= form_with model: @trip, local: true, class: "space-y-4" do |form| %>

    <!-- Trip Name -->
    <div class="flex flex-col">
      <%= form.label :name, "Trip Name", class: "mb-1 font-medium text-medium_brown" %>
      <%= form.text_field :name, class: "border border-gray-300 rounded px-3 py-2 focus:ring focus:ring-secondary-red focus:outline-none" %>
    </div>

    <!-- Description -->
    <div class="flex flex-col">
      <%= form.label :description, "Description", class: "mb-1 font-medium text-medium_brown" %>
      <%= form.text_area :description, rows: 4, class: "border border-gray-300 rounded px-3 py-2 focus:ring focus:ring-secondary-red focus:outline-none" %>
    </div>

    <!-- Start Date -->
    <div class="flex flex-col">
      <%= form.label :start_date, "Start Date", class: "mb-1 font-medium text-medium_brown" %>
      <%= form.date_field :start_date, class: " border border-gray-300 rounded px-3 py-2 focus:ring focus:ring-off_white focus:outline-none" %>
    </div>

    <!-- End Date -->
    <div class="flex flex-col">
      <%= form.label :end_date, "End Date", class: "mb-1 font-medium text-medium_brown" %>
      <%= form.date_field :end_date, class: "border border-gray-300 rounded px-3 py-2 focus:ring focus:ring-secondary-red focus:outline-none" %>
    </div>

    <!-- Participants -->
    <div class="flex flex-col">
      <%= form.label :participant_ids, "Participants", class: "mb-1 font-medium text-medium_brown" %>
      <div class="space-y-2">
        <% @users.each do |user| %>
          <div class="flex items-center">
            <%= check_box_tag "trip[participant_ids][]", user.id, @trip.participant_ids.include?(user.id), id: "participant_#{user.id}", class: "h-4 w-4 text-blue-600 focus:ring focus:ring-secondary-red rounded" %>
            <%= label_tag "participant_#{user.id}", user.email, class: "ml-2 text-medium_brown" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Submit Button -->
    <div>
      <%= form.submit "Create Trip", class: "w-full bg-primary text-off_white px-4 py-2 rounded hover:bg-off_white hover:text-primary focus:ring focus:ring-secondary-red focus:outline-none" %>
    </div>

  <% end %>

  <!-- Back Link -->
  <div class="mt-4">
    <%= link_to "Back to Trips", trips_path, class: "text-dark_log hover:underline hover:text-light_brown" %>
  </div>
</div>
<%= render 'form' %>