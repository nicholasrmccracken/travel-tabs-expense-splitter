<!DOCTYPE html>
<html>
  <head>
    <title>TravelTabs</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application.tailwind", media: "all", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>


  <body class="bg-off_white">

    <!-- Navbar -->
    <nav class="primary-red bg-light_brown text-dark_brown shadow-md">
      <div class="container mx-auto flex justify-between items-center p-4">
        <!-- Logo -->
        <a href="/dashboard/" class="flex items-center space-x-2">
          <img src="<%= asset_path('dark_logo.png') %>" alt="TravelTabs Logo" class="h-10 w-auto" />
        </a>

        <div class="flex space-x-4 items-center">
          <% if user_signed_in? %>
            <span class="text-dark_brown font-medium">Hello, <%= current_user.email %></span>
            <%= link_to 'My Trips', trips_path, class: "px-3 py-2 bg-medium_brown text-dark_brown hover:bg-dark_brown rounded-md hover:text-light_brown button-animation" %> 
            <% if Trip.first.present? %>
              <%= link_to 'Expenses', trip_expenses_path(Trip.first), class: "px-3 py-2 bg-medium_brown text-dark_brown hover:bg-dark_brown rounded-md hover:text-light_brown button-animation" %>
            <% end %>
            <%= link_to "Edit Profile", edit_user_registration_path , class: "px-3 py-2 bg-medium_brown text-dark_brown rounded-md hover:bg-dark_brown hover:text-light_brown button-animation" %>
            <%= link_to 'Sign Out', destroy_user_session_path, method: :delete, class: "px-3 py-2 bg-medium_brown text-dark_brown rounded-md hover:bg-dark_brown hover:text-light_brown button-animation" %>
          <% else %>
            <%= link_to 'Sign In', new_user_session_path, class: "px-3 py-2 bg-medium_brown text-dark_brown rounded-md hover:bg-dark_brown hover:text-light_brown button-animation" %>
            <%= link_to 'Sign Up', new_user_registration_path, class: "px-3 py-2 bg-medium_brown text-dark_brown rounded-md hover:bg-dark_brown hover:text-light_brown button-animation" %>
          <% end %>
        </div>

         <!-- Hamburger Menu -->
    <div class="relative">
      <button id="menu-toggle" class="text-dark_brown focus:outline-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    
    
    <div
    id="menu-options"
    class="absolute hidden bg-light_brown text-dark_brown right-0 mt-2 py-2 w-48 rounded-md shadow-lg"
    onmouseleave="hideMenu()"
    >
    <% if user_signed_in? %>
      <%= link_to 'My Trips', trips_path, class: "block text-dark_brown px-3 py-2 rounded-md hover:bg-dark_brown hover:text-light_brown" %>
            <% if Trip.first.present? %>
              <%= link_to 'Expenses', trip_expenses_path(Trip.first), class: "px-3 py-2 bg-medium_brown text-dark_brown hover:bg-dark_brown rounded-md hover:text-light_brown button-animation" %>
            <% end %>
      <%= link_to "Edit Profile", edit_user_registration_path, class: "block text-dark_brown px-3 py-2 rounded-md hover:bg-dark_brown hover:text-light_brown" %>
      <%= link_to 'Sign Out', destroy_user_session_path, method: :delete, class: "block text-dark_brown px-3 py-2 rounded-md hover:bg-dark_brown hover:text-light_brown" %>
    <% else %>
      <%= link_to 'Sign In', new_user_session_path, class: "block text-dark_brown px-3 py-2 rounded-md hover:bg-dark_brown hover:text-light_brown" %>
      <%= link_to 'Sign Up', new_user_registration_path, class: "block text-dark_brown px-3 py-2 rounded-md hover:bg-dark_brown hover:text-light_brown" %>
    <% end %>
      </div>
    </div>
  </div>
  </nav>

    <% if user_signed_in? %>
      <p class="notice"><%= notice %></p>
      <p class="alert"><%= alert %></p>
      <%= yield %>
    <% else %>
      <p class="notice"><%= notice %></p>
      <p class="alert"><%= alert %></p>
      <div class="flex justify-center gap-10p items-center min-h-screen bg-pale_brown"> 
         <div class="mb-4">
         <img src="<%= asset_path('dark_logo.png') %>" alt="Description of image" class="w-80 h-auto" style="width: 40rem;" />
      </div>
        <%= yield %>
      </div>
    <% end %>
  </body>
</html>

