<!DOCTYPE html>
<html>
  <head>
    <title>TravelTabs</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application.tailwind", media: "all", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
</html>

  <body class="bg-off_white">
  <body>

    <!-- Navbar -->
    <nav class="primary-red text-white shadow-md">
      <div class="container mx-auto flex justify-between items-center p-4">
        <a href="/" class="text-2xl font-bold hover:text-gray-200">TravelTabs</a>
        <div class="flex space-x-4 items-center">
          <% if user_signed_in? %>
            <span class="text-white font-medium">Hello, <%= current_user.email %></span>
            <%= link_to 'My Trips', trips_path, class: "px-3 py-2 bg-light_brown text-dark_brown" %> 
            <%= link_to 'Sign Out', destroy_user_session_path, method: :delete, class: "px-3 py-2 bg-light_brown text-dark_brown rounded-md hover:bg-medium_brown" %>
          <% else %>
            <%= link_to 'Sign In', new_user_session_path, class: "px-3 py-2 bg-light_brown text-dark_brown rounded-md hover:bg-medium_brown" %>
            <%= link_to 'Sign Up', new_user_registration_path, class: "px-3 py-2 bg-light_brown text-dark_brown rounded-md hover:bg-medium_brown" %>
          <% end %>
        </div>
      </div>
    </nav>
    <% if user_signed_in? %>

      <p class="notice"><%= notice %></p>
      <p class="alert"><%= alert %></p>

      <%= yield %>
    <% else %>
        <p class="notice"><%= notice %></p>
        <p class="alert"><%= alert %></p>
      <div class="flex justify-center items-center flex-col min-h-screen bg-pale_brown"> 
         <div class="mb-4">
          <img src="<%= asset_path('dark_logo.png') %>" alt="Description of image" class="w-80 h-auto" />
        </div>
        <div>
          <%= yield %>
        </div>
      </div>
    <% end %>
  </body>
</html>
