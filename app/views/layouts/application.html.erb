<!DOCTYPE html>
<html>
  <head>
    <title>SplitBuddy</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application.tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <!-- Navbar -->
    <nav class="bg-blue-500 text-white shadow-md">
      <div class="container mx-auto flex justify-between items-center p-4">
        <a href="/" class="text-2xl font-bold hover:text-gray-200">SplitBuddy</a>
        <div class="flex space-x-4 items-center">
          <% if user_signed_in? %>
            <span class="text-white font-medium">Hello, <%= current_user.email %></span>
            <%= link_to 'My Trips', trips_path, class: "px-3 py-2 bg-white text-blue" %> 
            <%= link_to 'Sign Out', destroy_user_session_path, method: :delete, class: "px-3 py-2 bg-white text-blue-500 rounded-md hover:bg-gray-100" %>
          <% else %>
            <%= link_to 'Sign In', new_user_session_path, class: "px-3 py-2 bg-white text-blue-500 rounded-md hover:bg-gray-100" %>
            <%= link_to 'Sign Up', new_user_registration_path, class: "px-3 py-2 bg-white text-blue-500 rounded-md hover:bg-gray-100" %>
          <% end %>
        </div>
      </div>
    </nav>

  <body class="bg-background-red">
    <p class="notice"><%= notice %></p>
    <p class="alert"><%= alert %></p>

    <%= yield %>
  </body>
</html>
