<!DOCTYPE html>
<html>
  <head>
    <title>TravelTabs</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application.tailwind", media: "all", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>


  <body class="bg-light_logo">

    <!-- Navbar -->
    <nav class="bg-red-500 text-white shadow-md sticky top-0 z-50">
      <div class="container mx-auto flex justify-between items-center py-4 px-6">
        <!-- Logo -->
        <a href="/" class="text-3xl font-extrabold tracking-wider text-light_logo hover:text-dark_logo">
          TravelTabs
        </a>
        
        <!-- Search Bar -->
    <form action="/search" method="get" class="hidden lg:flex items-center space-x-2 bg-light-gray text-gray px-4 py-2 rounded-md">
      <input type="text" name="q" placeholder="Search..." class="bg-transparent focus:outline-none w-full" />
      <button type="submit" class="text-primary-red hover:text-accent_red">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2 2 4-4M15 10a5 5 0 11-10 0 5 5 0 0110 0z" />
        </svg>
      </button>
    </form>

        <!-- Desktop Menu -->
        <div class="hidden lg:flex items-center space-x-6">
          <% if user_signed_in? %>
            <span class="text-lg font-medium">Hello, <%= current_user.email %></span>
            <%= link_to 'Dashboard', dashboard_path, class: "flex items-center space-x-2 px-4 py-2 rounded-md bg-white text-primary-red font-semibold hover:bg-background-grey transition duration-200" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path d="M12 2a2 2 0 100-4 2 2 0 000 4z" />
              </svg>
              <span>Dashboard</span>
            <% end %>

            <%= link_to 'My Trips', trips_path, class: "px-4 py-2 rounded-md bg-white text-primary-red font-semibold hover:bg-background-grey transition duration-200" %>
            <%= link_to 'Settings', edit_user_registration_path, class: "px-4 py-2 rounded-md bg-white text-primary-red font-semibold hover:bg-background-grey transition duration-200" %>

       <!-- Dropdown Menu -->
            <div class="relative group">
              <button class="flex items-center space-x-2 px-4 py-2 bg-secondary-grey rounded-md hover:bg-primary-grey">
                <span>Menu</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute hidden group-hover:block bg-light-gray text-primary-grey rounded-md shadow-md mt-2">
                <%= link_to 'Profile', edit_user_registration_path, class: "block px-4 py-2 hover:bg-background-grey" %>
                <%= link_to 'Sign Out', destroy_user_session_path, method: :delete, class: "block px-4 py-2 hover:bg-background-grey" %>
              </div>
            </div>
          <% else %>
            <%= link_to 'Home', root_path, class: "px-4 py-2 rounded-md bg-white text-primary-red font-semibold hover:bg-background-grey transition duration-200" %>
            <%= link_to 'About', about_path, class: "px-4 py-2 rounded-md bg-white text-primary-red font-semibold hover:bg-background-grey transition duration-200" %>
            <%= link_to 'Sign In', new_user_session_path, class: "px-4 py-2 rounded-md bg-white text-primary-red font-semibold hover:bg-background-grey transition duration-200" %>
            <%= link_to 'Sign Up', new_user_registration_path, class: "px-4 py-2 rounded-md bg-white text-primary-red font-semibold hover:bg-background-grey transition duration-200" %>
          <% end %>
        </div>

         <!-- Hamburger Menu -->
    <div class="lg:hidden">
      <button id="menu-toggle" class="text-white focus:outline-none">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
      </div>
    </nav>

    <p class="notice"><%= notice %></p>
    <p class="alert"><%= alert %></p>

    <%= yield %>
  </body>
</html>
