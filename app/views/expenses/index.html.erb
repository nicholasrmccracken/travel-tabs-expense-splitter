<h1 class="text-2xl font-bold mb-6">Expenses for Your Trips</h1>

<% @trips.each do |trip| %>
  <div class="bg-gray-100 shadow-md rounded-lg p-6 mb-8">
    <h2 class="text-xl font-bold text-gray-700 mb-4"><%= trip.name %></h2>

    <% if trip.expenses.any? %>
      <% trip.expenses.each do |expense| %>
        <div class="bg-white shadow-md rounded-lg p-4 mb-4">
          <p class="text-lg font-medium text-gray-800">
            <%= expense.description %>: 
            <span class="text-blue-600 font-semibold"><%= number_to_currency(expense.amount) %></span>
          </p>
        </div>
      <% end %>
    <% else %>
      <p class="text-gray-600">No expenses recorded for this trip yet.</p>
    <% end %>

    <%= link_to 'Add New Expense', new_trip_expense_path(trip), class: 'inline-block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 focus:ring focus:ring-blue-300' %>
  </div>
<% end %>
