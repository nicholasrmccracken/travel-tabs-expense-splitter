<div class="max-w-xl mx-auto mt-6 bg-white rounded-lg p-4">
  <%= form_with model: [@trip, @expense], local: true, class: "space-y-4" do |form| %>

    <!-- Description -->
    <div class="flex flex-col">
      <%= form.label :description, "Expense Description", class: "mb-1 font-medium text-dark_brown" %>
      <%= form.text_field :description, class: "bg-gray-50 border border-gray-300 rounded px-3 py-2 focus:ring focus:ring-blue-300 focus:outline-none" %>
    </div>

    <!-- Amount -->
    <div class="flex flex-col">
      <%= form.label :amount, "Amount", class: "mb-1 font-medium text-dark_brown" %>
      <%= form.number_field :amount, step: 0.01, class: "bg-gray-50 border border-gray-300 rounded px-3 py-2 focus:ring focus:ring-blue-300 focus:outline-none" %>
    </div>

    <!-- Date -->
    <div class="flex flex-col">
      <%= form.label :date, "Expense Date", class: "mb-1 font-medium text-dark_brown" %>
      <%= form.date_field :date, class: "bg-gray-50 border border-gray-300 rounded px-3 py-2 focus:ring focus:ring-blue-300 focus:outline-none" %>
    </div>

    <!-- Share Type -->
    <div class="flex flex-col">
      <%= form.label :share_type, "Divide Expense By", class: "mb-1 font-medium text-dark_brown" %>
      <%= select_tag "expense[share_type]", 
                     options_for_select([['Amount ($)', 'amount'], ['Percentage (%)', 'percentage']], selected: @expense.share_type || 'amount'), 
                     class: "bg-gray-50 border border-gray-300 rounded px-3 py-2 focus:ring focus:ring-blue-300 focus:outline-none" %>
    </div>

    <!-- Shared Users -->
    <div class="flex flex-col">
      <%= form.label :expense_participants, "Shared Participants", class: "mb-1 font-medium text-dark_brown" %>
      <div class="space-y-4">
        <% @trip.users.each do |user| %>
          <div class="bg-gray-100 border border-gray-300 rounded-lg p-4">
            <div class="flex items-center space-x-4">
              <!-- User Check -->
              <%= check_box_tag "expense[expense_participants_attributes][#{user.id}][user_id]", user.id, false, id: "participant_#{user.id}", class: "h-4 w-4 text-blue-600 focus:ring focus:ring-blue-300 rounded" %>
              <%= label_tag "participant_#{user.id}", user.email, class: "text-dark_brown" %>
              <!-- Share Value -->
              <%= number_field_tag "expense[expense_participants_attributes][#{user.id}][share_value]", nil, 
                                   placeholder: "Enter value", 
                                   step: "any", 
                                   class: "bg-gray-50 border border-gray-300 rounded px-3 py-2 w-full focus:ring focus:ring-blue-300 focus:outline-none" %>

            </div>
          </div>
        <% end %>
      </div>
    </div>
  
    <!-- Submit Button -->
    <div>
      <%= form.submit class: "w-full bg-dark_brown text-white px-4 py-2 rounded hover:bg-light_brown hover:text-dark_brown focus:ring focus:ring-blue-300 focus:outline-none" %>
    </div>
  <% end %>
</div>
